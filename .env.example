# Copie para .env e preencha. O .env NÃO vai para o git.
SPRING_PROFILES_ACTIVE=dev

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pluviffar
SPRING_DATASOURCE_USERNAME=pluviffar
SPRING_DATASOURCE_PASSWORD=

# Primeiro ADMIN (usado pela migration V2__SeedAdmin; senha com 12+ caracteres). Troca obrigatória no primeiro login.
PLUVIFFAR_ADMIN_EMAIL=
PLUVIFFAR_ADMIN_PASSWORD=

# Domínios do frontend autorizados no CORS (separados por vírgula)
PLUVIFFAR_CORS_ALLOWED_ORIGINS=http://localhost:3000