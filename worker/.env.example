# Copie para .env (o instalar.sh faz isso em /opt/pluvio-worker/.env) e preencha.
# O .env NÃO vai para o git.

# Broker MQTT (Mosquitto na própria VPS)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=pluviometro
MQTT_PASS=troque-esta-senha
MQTT_TOPIC=pluviffar/#
MQTT_CLIENT_ID=pluvio-worker

# PostgreSQL (mesmo banco da API; schema public)
PG_DSN=host=localhost port=5432 dbname=pluviffar user=pluviffar password=troque-esta-senha

# Máximo de mensagens esperando na fila em memória (banco fora do ar)
QUEUE_MAX=10000
# Fuso usado para timestamps ISO 8601 sem offset
TZ_SEM_OFFSET=America/Sao_Paulo
LOG_LEVEL=INFO
